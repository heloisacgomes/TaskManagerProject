<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.controller.TelaListagemController">

    <center>

        <VBox spacing="25"
              alignment="CENTER">

          <TableView fx:id="tabelaTarefas"
           prefWidth="650"
           prefHeight="300">

                <columns>

                    <TableColumn fx:id="colTitulo"
                                 text="Tarefa"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colDescricao"
                                 text="Descrição"
                                 prefWidth="430"/>

                </columns>

            </TableView>

            <HBox spacing="5"
                  alignment="CENTER"
                  prefWidth="5"
                  style="-fx-padding: 5 0 5 0;">

                <Button text="Nova Tarefa"
                        onAction="#abrirCadastro"
                        styleClass="botao-principal"/>

                <Button text="Editar"
                        onAction="#editarTarefa"
                        styleClass="botao-secundario"/>

                <Button text="Concluir"
                        onAction="#concluirTarefa"
                        styleClass="botao-secundario"/>

                <Button text="Remover"
                        onAction="#removerTarefa"
                        styleClass="botao-remover"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>